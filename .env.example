# Lanka Offers Public Consumer Backend API — Environment Configuration
# Copy this file to .env for local development. Never commit real credentials.

# Application environment (development | production | test)
NODE_ENV=development

# HTTP Port for public consumer API (default: 3001)
PORT=3001

# Neon Postgres Pooled Connection URL (read-only consumer credentials recommended)
# Example: postgresql://readonly_user:password@ep-pooler.region.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Allowed CORS Origins (comma-separated, e.g. https://lanka-offers.me,http://localhost:3000)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Logging Level (error | warn | info | debug)
LOG_LEVEL=info
