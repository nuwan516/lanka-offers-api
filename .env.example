# Lanka Offers Public Consumer Backend API — Environment Configuration
# Copy this file to .env for local development. Never commit real credentials.

# Application environment (development | production | test)
NODE_ENV=development

# HTTP Port for public consumer API (default: 3001)
PORT=3001

# Neon Postgres Connection URLs:
# DATABASE_PUBLIC_URL is STRICTLY REQUIRED in production (NODE_ENV=production)
# to enforce least-privilege role boundaries (role: lanka_offers_public_api).
# DATABASE_URL is used in development/test or as administrative connection string.
DATABASE_PUBLIC_URL=postgresql://lanka_offers_public_api:password@ep-pooler.region.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:password@ep-pooler.region.neon.tech/neondb?sslmode=require

# Allowed CORS Origins (comma-separated, e.g. https://lanka-offers.me,http://localhost:3000)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Logging Level (error | warn | info | debug)
LOG_LEVEL=info

# Shared persistent directory containing immutable, content-addressed offer images.
# Admin API writes verified assets; this public API serves only keys associated
# with active PUBLISHED offers. Use the same mounted volume in both processes.
IMAGE_STORAGE_DIR=data/images

# ─── Nearby offers Redis cache (optional) ─────────────────────────────────────
# When unset, nearby queries hit Postgres directly (no cache).
# REDIS_URL=redis://127.0.0.1:6379/0
# TTL seconds for nearby responses (default 420 = 7 minutes; clamp 60–3600)
# NEARBY_CACHE_TTL_SECONDS=420
# Bump to logically flush all nearby keys without SCAN/DEL
# NEARBY_CACHE_VERSION=1
